<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomTextStyle1">
        <item name="android:textColor">#FF5722</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="CustomTextStyle2">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">#009688</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="InheritedStyle" parent="@style/CustomTextStyle2">
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">#123456</item>
    </style>

    <style name="MyRoundedButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">#FF5722</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:paddingHorizontal">25dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

</resources>